// Ghost-Downloader-3 Slint UI（Phase 7a 脚手架。
// 当前只装一个最小窗口骨架，逐页 strangler 迁移时按 Qt 版一一镜像展开。

import { VerticalBox } from "std-widgets.slint";
import { TaskPage, TaskRow } from "task_page.slint";
import { SettingsPage } from "settings_page.slint";

export component AppWindow inherits Window {
    title: "Ghost-Downloader-3";
    min-width: 640px;
    min-height: 400px;

    in property <string> statusText: "Ghost-Downloader-3 (Slint)";
    in property <[TaskRow]> tasks;
    // filterMode：Rust 侧写「路由字面量」；段高亮在 TaskPage 内由
    // filterMode 派生后经 `<=>` 链回读到 AppWindow 供测试读取。
    in property <string> filterMode: "all";
    // 设置页四键（第 32 步先验集）。
    in-out property <string> downloadFolder: "";
    in-out property <int> maxTaskNum: 3;
    in-out property <int> preBlockNum: 8;
    in-out property <bool> categoryEnabled: false;
    // 第 33 步：限速值窗口属性用显示口径 KB/s（单位名缀入属性名，
    // 字节 ⇄ KB 换算归 Rust speed.rs 镜像层，不进 slint）。
    in-out property <int> speedLimitationKb: 4096;
    // 第 34 步：GeneralDownload 组剩余简版键（缺省与 cfg.py 一致；
    // nameConflictIndex 镜像 ComboBoxSettingCard——索引 i ⇄
    // options[i]，字面量映射归 Rust conflict.rs）。
    in-out property <bool> autoSpeedUp: true;
    in-out property <int> maxReassignSize: 512;
    in-out property <bool> preserveLastModified: false;
    in-out property <bool> verifySsl: false;
    in-out property <int> nameConflictIndex: 0;
    in-out property <bool> useSystemDns: true;
    // 第 35 步：ProxyServer（cfg.py 缺省 Auto；choice 0 Off/1 Auto/
    // 2 自定义，映射与拼装/校验归 Rust proxy.rs + install 层）。
    in-out property <int> proxyChoice: 1;
    in-out property <int> proxyProtocolIndex: 0;
    in-out property <string> proxyHost: "";
    in-out property <string> proxyPort: "";
    in-out property <string> proxyUser: "";
    in-out property <string> proxyPass: "";
    // 第 36 步：Aria2 RPC 兼容组（cfg.py:277-280 缺省 F/16800/""/F）。
    in-out property <bool> aria2Enabled: false;
    in-out property <int> aria2RpcPort: 16800;
    in-out property <string> aria2RpcToken: "";
    in-out property <bool> aria2EmulateFingerprint: false;
    // 段高亮唯一派生点（`<=>` 双链初值竞态实证会互相覆盖，套单向
    // 传入：窗口层派生 → TaskPage 消费）。
    in-out property <bool> highlightAll: root.filterMode == "all";
    in-out property <bool> highlightActive: root.filterMode == "active";
    in-out property <bool> highlightCompleted: root.filterMode == "completed";
    in property <[string]> categoryNames;
    // categoryEnabled 与设置页「启用下载分类」是同一配置键
    // （cfg.isCategoryEnabled；task_page.py:93/241 仅消费可见性）——
    // 窗口级单一份：SettingsPage 双链写、TaskPage 单向消费。
    in-out property <int> categoryIndex: 0;
    in-out property <int> sortFieldIndex: 0;
    in-out property <int> sortOrderIndex: 1;
    callback searchChanged(string);
    callback filterModeChanged(string);
    callback taskPause(string);
    callback taskDelete(string);
    callback categoryFilterChanged(int);
    callback downloadFolderChanged(string);
    callback maxTaskNumChanged(int);
    callback preBlockNumChanged(int);
    callback categoryEnabledChanged(bool);
    callback speedLimitationChanged(int);
    callback autoSpeedUpChanged(bool);
    callback maxReassignSizeChanged(int);
    callback preserveLastModifiedChanged(bool);
    callback verifySslChanged(bool);
    callback nameConflictChanged(int);
    callback useSystemDnsChanged(bool);
    callback proxyChoiceChanged(int);
    callback proxyFieldsChanged(int, string, string, string, string);
    callback aria2EnabledChanged(bool);
    callback aria2RpcPortChanged(int);
    callback aria2RpcTokenChanged(string);
    callback aria2EmulateFingerprintChanged(bool);
    callback sortFieldChanged(int);
    callback sortOrderChanged(int);

    VerticalBox {
        Text {
            text: root.statusText;
            font-size: 18px;
            vertical-alignment: center;
        }
        TaskPage {
            tasks: root.tasks;
            filterMode: root.filterMode;
            highlightAll: root.highlightAll;
            highlightActive: root.highlightActive;
            highlightCompleted: root.highlightCompleted;
            categoryNames: root.categoryNames;
            categoryEnabled: root.categoryEnabled;
            categoryIndex <=> root.categoryIndex;
            sortFieldIndex <=> root.sortFieldIndex;
            sortOrderIndex <=> root.sortOrderIndex;
            searchChanged(value) => { root.searchChanged(value); }
            filterModeChanged(value) => { root.filterModeChanged(value); }
            taskPause(taskId) => { root.taskPause(taskId); }
            taskDelete(taskId) => { root.taskDelete(taskId); }
            categoryFilterChanged(index) => { root.categoryFilterChanged(index); }
            sortFieldChanged(index) => { root.sortFieldChanged(index); }
            sortOrderChanged(index) => { root.sortOrderChanged(index); }
        }
        SettingsPage {
            downloadFolder <=> root.downloadFolder;
            maxTaskNum <=> root.maxTaskNum;
            preBlockNum <=> root.preBlockNum;
            categoryEnabled <=> root.categoryEnabled;
            downloadFolderChanged(value) => { root.downloadFolderChanged(value); }
            maxTaskNumChanged(value) => { root.maxTaskNumChanged(value); }
            preBlockNumChanged(value) => { root.preBlockNumChanged(value); }
            categoryEnabledChanged(value) => { root.categoryEnabledChanged(value); }
            speedLimitationKb <=> root.speedLimitationKb;
            speedLimitationChanged(kb) => { root.speedLimitationChanged(kb); }
            autoSpeedUp <=> root.autoSpeedUp;
            maxReassignSize <=> root.maxReassignSize;
            preserveLastModified <=> root.preserveLastModified;
            verifySsl <=> root.verifySsl;
            nameConflictIndex <=> root.nameConflictIndex;
            useSystemDns <=> root.useSystemDns;
            autoSpeedUpChanged(v) => { root.autoSpeedUpChanged(v); }
            maxReassignSizeChanged(v) => { root.maxReassignSizeChanged(v); }
            preserveLastModifiedChanged(v) => { root.preserveLastModifiedChanged(v); }
            verifySslChanged(v) => { root.verifySslChanged(v); }
            nameConflictChanged(v) => { root.nameConflictChanged(v); }
            useSystemDnsChanged(v) => { root.useSystemDnsChanged(v); }
            proxyChoice <=> root.proxyChoice;
            proxyProtocolIndex <=> root.proxyProtocolIndex;
            proxyHost <=> root.proxyHost;
            proxyPort <=> root.proxyPort;
            proxyUser <=> root.proxyUser;
            proxyPass <=> root.proxyPass;
            proxyChoiceChanged(c) => { root.proxyChoiceChanged(c); }
            proxyFieldsChanged(p, h, t, u, w) => { root.proxyFieldsChanged(p, h, t, u, w); }
            aria2Enabled <=> root.aria2Enabled;
            aria2RpcPort <=> root.aria2RpcPort;
            aria2RpcToken <=> root.aria2RpcToken;
            aria2EmulateFingerprint <=> root.aria2EmulateFingerprint;
            aria2EnabledChanged(v) => { root.aria2EnabledChanged(v); }
            aria2RpcPortChanged(v) => { root.aria2RpcPortChanged(v); }
            aria2RpcTokenChanged(t) => { root.aria2RpcTokenChanged(t); }
            aria2EmulateFingerprintChanged(v) => { root.aria2EmulateFingerprintChanged(v); }
        }
    }
}
