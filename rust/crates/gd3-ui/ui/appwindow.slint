// Ghost-Downloader-3 Slint UI 主窗口（Phase 7c 第 57 步：外壳接线）。
//
// 布局镜像 `main_window.py::_initLayout`：
//   左导航栏（190px，TOP 组 + 弹性空隙 + BOTTOM 组）
//   └ 右侧 VerticalLayout（标题栏 48px 含搜索框 + 页面栈）
// 通知条 / 消息框 / 任务抽屉 / 拖放区都是同级覆盖层（绝对定位），
// 顺序即 z 序：主内容 → 通知条 → 抽屉 → 消息框 → 拖放区。
//
// 语义镜像、不追求像素一致：图标只有名字（`NavItemData.icon`），
// 主题色/圆角/阴影留给主题对齐步。

import { LineEdit } from "std-widgets.slint";
import { TaskPage, TaskRow } from "task_page.slint";
import { DrawerChecksumRow, DrawerFileRow, DrawerInfoRow, TaskDrawer } from "task_drawer.slint";
import { BarButtonData, NavButton, NavItemData, ShellInfoBar, ShellMessageDialog } from "app_shell.slint";
import { CardMenuPopup, CardMenuRowData } from "card_menu.slint";
import { ExtensionInstallDialog, InstallStep } from "extension_install.slint";
import {
    CategoryEditDraft,
    HeadersEditDraft,
    IdentityEditDraft,
    SettingsPage,
    IdentityPresetData,
    CategoryRowData,
} from "settings_page.slint";

export component AppWindow inherits Window {
    title: "Ghost-Downloader-3";
    min-width: 640px;
    min-height: 400px;

    in property <string> statusText: "Ghost-Downloader-3 (Slint)";
    in property <[TaskRow]> tasks;
    // filterMode：Rust 侧写「路由字面量」；段高亮在 TaskPage 内由
    // filterMode 派生后经 `<=>` 链回读到 AppWindow 供测试读取。
    in property <string> filterMode: "all";
    // 设置页四键（第 32 步先验集）。
    in-out property <string> downloadFolder: "";
    in-out property <int> maxTaskNum: 3;
    in-out property <int> preBlockNum: 8;
    in-out property <bool> categoryEnabled: false;
    // 第 33 步：限速值窗口属性用显示口径 KB/s（单位名缀入属性名，
    // 字节 ⇄ KB 换算归 Rust speed.rs 镜像层，不进 slint）。
    in-out property <int> speedLimitationKb: 4096;
    // 第 34 步：GeneralDownload 组剩余简版键（缺省与 cfg.py 一致；
    // nameConflictIndex 镜像 ComboBoxSettingCard——索引 i ⇄
    // options[i]，字面量映射归 Rust conflict.rs）。
    in-out property <bool> autoSpeedUp: true;
    in-out property <int> maxReassignSize: 512;
    in-out property <bool> preserveLastModified: false;
    in-out property <bool> verifySsl: false;
    in-out property <int> nameConflictIndex: 0;
    in-out property <bool> useSystemDns: true;
    // 第 35 步：ProxyServer（cfg.py 缺省 Auto；choice 0 Off/1 Auto/
    // 2 自定义，映射与拼装/校验归 Rust proxy.rs + install 层）。
    in-out property <int> proxyChoice: 1;
    in-out property <int> proxyProtocolIndex: 0;
    in-out property <string> proxyHost: "";
    in-out property <string> proxyPort: "";
    in-out property <string> proxyUser: "";
    in-out property <string> proxyPass: "";
    // 第 36 步：Aria2 RPC 兼容组（cfg.py:277-280 缺省 F/16800/""/F）。
    in-out property <bool> aria2Enabled: false;
    in-out property <int> aria2RpcPort: 16800;
    in-out property <string> aria2RpcToken: "";
    in-out property <bool> aria2EmulateFingerprint: false;
    // 第 37 步：浏览器扩展组简版三键（cfg.py:268-272 缺省 T/F/14370；
    // 草稿模式键名 EnableRaiseWindowWhenReceiveMsg 注记见 settings_page）。
    in-out property <bool> browserEnabled: true;
    in-out property <bool> browserDraftTaken: false;
    in-out property <int> browserPort: 14370;
    // 第 40 步：浏览器扩展动作卡（cfg.py:269 缺省 ""；复制/重新生成/
    // 商店链接/一键安装/导出 CRX 动作的真实生效归调用方与引擎桥接步）。
    in-out property <string> pairToken: "";
    // 第 41 步：模拟身份（Network/ClientProfile 缺省 "auto"；映射归
    // Rust profile.rs，引擎解析对接 gd3-net resolve_emulation）。
    in-out property <int> clientProfileIndex: 0;
    // 第 42 步：请求标头预设（解析/校验/兜底归 Rust headers.rs，
    // 预设添加/编辑对话框留欠账步）。
    in-out property <[string]> headersPresetNames;
    in-out property <int> headersPresetIndex: 0;
    in-out property <int> headersPresetHeaderCount: 0;
    in-out property <bool> headersPresetCanRemove: false;
    in-out property <bool> headersEditVisible;
    in-out property <int> headersEditIndex: -1;
    in-out property <string> headersEditName;
    in-out property <string> headersEditPairs;
    in-out property <bool> headersEditNameError;
    in-out property <string> headersEditDuplicateWarning;
    // 第 43 步：身份预设列表（行结构镜像 PresetRowWidget；编辑/添加
    // 留欠账步）。
    in-out property <[IdentityPresetData]> identityPresets;
    // 第 47 步：身份预设添加/编辑覆盖层（hosts 解析/校验/名称兜底
    // 归 Rust identity.rs；index 缺省 -1 写在根组件，`<=>` 下才生效）。
    in-out property <bool> identityEditVisible;
    in-out property <int> identityEditIndex: -1;
    in-out property <string> identityEditName;
    in-out property <string> identityEditHosts;
    in-out property <bool> identityEditHostsError;
    in-out property <string> identityEditProfile;
    in-out property <int> identityEditProfileIndex: 0;
    in-out property <[string]> identityEditProfileLabels;
    in-out property <[string]> identityEditProfileValues;
    in-out property <string> identityEditUserAgent;
    in-out property <bool> identityEditHelpVisible;
    in-out property <[CategoryRowData]> categoryRows;
    in-out property <int> categoryRuleCount;
    in-out property <[string]> categoryIconChoices;
    in-out property <bool> categoryEditVisible;
    in-out property <string> categoryEditId;
    in-out property <string> categoryEditName;
    in-out property <int> categoryEditIconIndex;
    in-out property <string> categoryEditExtensions;
    in-out property <string> categoryEditFolder;
    // 第 38 步：关联 urlScheme 静态卡 + 软件组简版五键
    // （cfg.py 缺省 T/T/F/"Ask"/T；CloseMode 映射归 close_mode.rs）。
    in-out property <bool> urlSchemeEnabled: true;
    in-out property <bool> checkUpdateAtStartup: true;
    in-out property <bool> runAtLogin: false;
    in-out property <int> closeModeIndex: 0;
    in-out property <bool> clipboardListener: true;
    // 第 39 步：DpiScale 界面缩放（显示口径 %，0-500 步 25；配置 0-5
    // 浮点换算归 install 层，磁盘串 python str(float) 口径）。
    in-out property <int> uiScalePercent: 0;
    // 段高亮唯一派生点（`<=>` 双链初值竞态实证会互相覆盖，套单向
    // 传入：窗口层派生 → TaskPage 消费）。
    in-out property <bool> highlightAll: root.filterMode == "all";
    in-out property <bool> highlightActive: root.filterMode == "active";
    in-out property <bool> highlightCompleted: root.filterMode == "completed";
    in property <[string]> categoryNames;
    // categoryEnabled 与设置页「启用下载分类」是同一配置键
    // （cfg.isCategoryEnabled；task_page.py:93/241 仅消费可见性）——
    // 窗口级单一份：SettingsPage 双链写、TaskPage 单向消费。
    in-out property <int> categoryIndex: 0;
    in-out property <int> sortFieldIndex: 0;
    in-out property <int> sortOrderIndex: 1;
    // 第 53 步：任务抽屉（`drawer.rs` 五张卡片派生结果的装配位）。
    // 全部字段由 `open_task_drawer` 一次写齐；Slint 只显示与发回调。
    in-out property <bool> drawerVisible: false;
    in-out property <string> drawerTaskId: "";
    // HeaderCard
    in-out property <string> drawerTaskName: "";
    in-out property <int> drawerProgressValue: 0;
    in-out property <bool> drawerProgressVisible: false;
    in-out property <bool> drawerProgressError: false;
    in-out property <string> drawerStatusText: "";
    // ErrorBar
    in-out property <bool> drawerErrorVisible: false;
    in-out property <string> drawerErrorTitle: "下载失败";
    in-out property <string> drawerErrorText: "";
    // InfoCard
    in-out property <[DrawerInfoRow]> drawerInfoRows;
    // ChecksumCard
    in-out property <bool> drawerChecksumVisible: false;
    in-out property <[DrawerChecksumRow]> drawerChecksumRows;
    in-out property <bool> drawerChecksumError: false;
    in-out property <bool> drawerChecksumMatched: false;
    in-out property <string> drawerChecksumTooltip: "";
    in-out property <string> drawerExpectedChecksum: "";
    // FileListCard
    in-out property <bool> drawerFileListVisible: false;
    in-out property <[DrawerFileRow]> drawerFileRows;
    callback searchChanged(string);
    callback filterModeChanged(string);
    callback taskPause(string);
    callback taskDelete(string);
    // 第 51 步：卡片按钮回调（toggle / 选择文件 / 校验 / 打开文件 / 打开文件夹）。
    // Slint 只发 taskId 字面量，语义（按状态分派暂停-继续-做种等）在调用方。
    callback taskToggle(string);
    callback taskSelectFiles(string);
    callback taskChecksum(string);
    callback taskOpenFile(string);
    callback taskOpenFolder(string);
    // 第 53 步：任务抽屉。`taskOpenDrawer` 镜像卡片右键「任务详情」/
    // 点信息区打开抽屉（`_openDrawer`）；其余五路是抽屉内部动作，
    // 只带 taskId（+ 需要复制的文本），语义全在调用方。
    callback taskOpenDrawer(string);
    callback drawerCloseRequested(string);
    callback drawerExpectedChecksumEdited(string, string);
    callback drawerPasteChecksumRequested(string);
    callback drawerCopyTextRequested(string, string);
    callback drawerRevealInFolderRequested(string);
    callback categoryFilterChanged(int);
    callback downloadFolderChanged(string);
    callback maxTaskNumChanged(int);
    callback preBlockNumChanged(int);
    callback categoryEnabledChanged(bool);
    callback speedLimitationChanged(int);
    callback autoSpeedUpChanged(bool);
    callback maxReassignSizeChanged(int);
    callback preserveLastModifiedChanged(bool);
    callback verifySslChanged(bool);
    callback nameConflictChanged(int);
    callback useSystemDnsChanged(bool);
    callback proxyChoiceChanged(int);
    callback proxyFieldsChanged(int, string, string, string, string);
    callback aria2EnabledChanged(bool);
    callback aria2RpcPortChanged(int);
    callback aria2RpcTokenChanged(string);
    callback aria2EmulateFingerprintChanged(bool);
    callback browserEnabledChanged(bool);
    callback browserDraftTakenChanged(bool);
    callback browserPortChanged(int);
    callback clientProfileChanged(int);
    callback headersPresetPicked(int);
    callback headersPresetRemoveRequested(int);
    callback identityPresetToggled(int, bool);
    callback identityPresetRemoveRequested(int);
    callback headersPresetAddRequested();
    callback headersPresetEditRequested(int);
    callback headersPresetEditClosed();
    callback headersPresetEditAccepted(HeadersEditDraft);
    callback headersPresetPairsEdited(string);
    callback identityPresetAddRequested();
    callback identityPresetEditRequested(int);
    callback identityPresetEditClosed();
    callback identityPresetEditAccepted(IdentityEditDraft);
    callback categoryResetRequested();
    callback categoryRemoveRequested(string);
    callback categoryAddRequested();
    callback categoryEditRequested(string);
    callback categoryEditClosed();
    callback categoryEditAccepted(CategoryEditDraft);
    callback copyPairToken();
    callback regeneratePairToken();
    callback openStoreUrl(string);
    callback chromiumInstall();
    callback exportCrx();
    callback urlSchemeEnabledChanged(bool);
    callback checkUpdateAtStartupChanged(bool);
    callback runAtLoginChanged(bool);
    callback closeModeChanged(int);
    callback clipboardListenerChanged(bool);
    callback uiScaleChanged(int);
    callback sortFieldChanged(int);
    callback sortOrderChanged(int);

    // -----------------------------------------------------------------
    // 第 57 步：外壳（导航栏 / 标题栏搜索框 / 通知条 / 消息框 / 拖放区）
    // -----------------------------------------------------------------
    // 当前路由 = 页面栈里可见的那一页（`window::PAGE_TASK` / `PAGE_SETTINGS`）。
    in-out property <string> currentRoute: "TaskPage";
    // 导航项按 `NavigationItemPosition` 拆成两个 model（TOP 贴顶、BOTTOM
    // 贴底），顺序由 `window::nav_items_at` 给。
    in property <[NavItemData]> navTop;
    in property <[NavItemData]> navBottom;
    // 搜索框：`window::search_target(route)` 决定可见性与 placeholder。
    in-out property <bool> searchVisible: true;
    in property <string> searchPlaceholder: "搜索任务";
    in-out property <string> searchText: "";
    // 通知条（`InfoBar`）：形状来自 `window::listen_failed_info_bar` /
    // `update_available_info_bar`。
    in-out property <bool> infoBarVisible: false;
    in-out property <string> infoBarTitle: "";
    in-out property <string> infoBarText: "";
    in property <[BarButtonData]> infoBarButtons;
    // 消息框（`MessageBoxBase` 家族）：形状来自 `window::close_ask_dialog` /
    // `exception_dialog` / `pair_request_dialog`。`dialogCheckboxLabel == ""`
    // 即没有复选框。
    in-out property <bool> dialogVisible: false;
    in-out property <string> dialogTitle: "";
    in-out property <string> dialogText: "";
    in-out property <string> dialogCheckboxLabel: "";
    in-out property <bool> dialogCheckboxChecked: false;
    in property <[BarButtonData]> dialogButtons;
    // 扩展安装引导框（P3 第 123 步，镜像 `ExtensionInstallDialog`）：标题 / 五步 /
    // 两个按钮的文案全部来自 `gd3-ui::extension_install::Guide`，这里只留属性。
    in-out property <bool> extensionInstallVisible: false;
    // 解包目录：`confirmed` 时 `revealInFolder` 的目标（Python 构造参数 `path`）。
    in-out property <string> extensionInstallFolder: "";
    in property <string> extensionInstallTitle: "";
    in property <[InstallStep]> extensionInstallSteps;
    in property <string> extensionInstallPreviewText: "";
    in property <string> extensionInstallYesText: "";
    in property <string> extensionInstallCancelText: "";
    callback extensionInstallConfirmed;
    callback extensionInstallDismissed;
    // 卡片右键菜单（`RoundMenu`）：行列表由 `menu_view::MenuRow` 摊平，
    // 面板高度由 `menu_view::panel_height` 算好（Slint 布局无法回传子项高度和）。
    // 锚点/高度用 int 像素：值全部来自 Rust 侧的像素算术，避免 f32 边界换算。
    in-out property <bool> cardMenuOpened: false;
    in property <int> cardMenuX: 0;
    in property <int> cardMenuY: 0;
    in property <int> cardMenuHeight: 0;
    in property <[CardMenuRowData]> cardMenuRows;
    callback navItemClicked(string);
    callback searchEdited(string);
    callback infoBarButtonClicked(int);
    callback infoBarClosed();
    callback dialogButtonClicked(int);
    callback dialogCheckboxToggled(bool);
    // 摊平后的行号：子菜单行由 Rust 侧切换展开，其余解析成 `CardClick`。
    callback cardMenuActivated(int);
    callback cardMenuDismissed();
    // 拖放：`data-transfer` 在 Slint 里不透明，只能由宿主语言读
    // （`DataTransfer::has_file_paths` / `file_paths` / `plain_text`）。
    // 判定仍走 `window::drop_decision` / `drop_urls`。
    pure callback canDropPayload(data-transfer) -> bool;
    pure callback dropPayload(data-transfer);


    // 外层 Rectangle 撑满窗口并裁剪：所有覆盖层（通知条/抽屉/消息框/
    // 拖放区）都与主内容同级叠放，按声明顺序决定 z 序。
    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;
        background: white;

        // ---- 左侧导航栏（190px，镜像 `navigationInterface` 宽度）----
        Rectangle {
            x: 0;
            y: 0;
            width: 190px;
            height: parent.height;
            background: #f7f7f7;

            VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                for nav in root.navTop : NavButton {
                    item: nav;
                    clicked => {
                        root.navItemClicked(nav.routeKey);
                    }
                }
                // 弹性空隙：TOP 组贴顶、BOTTOM 组贴底。
                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }
                for nav in root.navBottom : NavButton {
                    item: nav;
                    clicked => {
                        root.navItemClicked(nav.routeKey);
                    }
                }
            }
        }

        // ---- 右侧：标题栏 + 页面栈 ----
        Rectangle {
            x: 190px;
            y: 0;
            width: parent.width - 190px;
            height: parent.height;

            VerticalLayout {
                // 标题栏（48px）：搜索框 + 状态文本。
                Rectangle {
                    height: 48px;
                    background: #fafafa;

                    Rectangle {
                        x: 0;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: #e5e5e5;
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        LineEdit {
                            width: 240px;
                            height: 32px;
                            visible: root.searchVisible;
                            placeholder-text: root.searchPlaceholder;
                            text <=> root.searchText;
                            edited(text) => {
                                root.searchEdited(text);
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }
                        Text {
                            text: root.statusText;
                            font-size: 13px;
                            color: #666;
                            vertical-alignment: center;
                        }
                    }
                }

                // 页面栈：两个页面绝对铺满，按 `currentRoute` 切换可见性
                // （镜像 `QStackedWidget`）。
                Rectangle {
                    clip: true;
                    background: white;

                    TaskPage {
                        visible: root.currentRoute == "TaskPage";
                        tasks: root.tasks;
                        filterMode: root.filterMode;
                        highlightAll: root.highlightAll;
                        highlightActive: root.highlightActive;
                        highlightCompleted: root.highlightCompleted;
                        categoryNames: root.categoryNames;
                        categoryEnabled: root.categoryEnabled;
                        categoryIndex <=> root.categoryIndex;
                        sortFieldIndex <=> root.sortFieldIndex;
                        sortOrderIndex <=> root.sortOrderIndex;
                        searchChanged(value) => { root.searchChanged(value); }
                        filterModeChanged(value) => { root.filterModeChanged(value); }
                        taskPause(taskId) => { root.taskPause(taskId); }
                        taskDelete(taskId) => { root.taskDelete(taskId); }
                        taskToggle(taskId) => { root.taskToggle(taskId); }
                        taskSelectFiles(taskId) => { root.taskSelectFiles(taskId); }
                        taskChecksum(taskId) => { root.taskChecksum(taskId); }
                        taskOpenFile(taskId) => { root.taskOpenFile(taskId); }
                        taskOpenFolder(taskId) => { root.taskOpenFolder(taskId); }
                        taskOpenDrawer(taskId) => { root.taskOpenDrawer(taskId); }
                        categoryFilterChanged(index) => { root.categoryFilterChanged(index); }
                        sortFieldChanged(index) => { root.sortFieldChanged(index); }
                        sortOrderChanged(index) => { root.sortOrderChanged(index); }
                    }

                    SettingsPage {
                        visible: root.currentRoute == "SettingPage";
                        downloadFolder <=> root.downloadFolder;
                        maxTaskNum <=> root.maxTaskNum;
                        preBlockNum <=> root.preBlockNum;
                        categoryEnabled <=> root.categoryEnabled;
                        downloadFolderChanged(value) => { root.downloadFolderChanged(value); }
                        maxTaskNumChanged(value) => { root.maxTaskNumChanged(value); }
                        preBlockNumChanged(value) => { root.preBlockNumChanged(value); }
                        categoryEnabledChanged(value) => { root.categoryEnabledChanged(value); }
                        speedLimitationKb <=> root.speedLimitationKb;
                        speedLimitationChanged(kb) => { root.speedLimitationChanged(kb); }
                        autoSpeedUp <=> root.autoSpeedUp;
                        maxReassignSize <=> root.maxReassignSize;
                        preserveLastModified <=> root.preserveLastModified;
                        verifySsl <=> root.verifySsl;
                        nameConflictIndex <=> root.nameConflictIndex;
                        useSystemDns <=> root.useSystemDns;
                        autoSpeedUpChanged(v) => { root.autoSpeedUpChanged(v); }
                        maxReassignSizeChanged(v) => { root.maxReassignSizeChanged(v); }
                        preserveLastModifiedChanged(v) => { root.preserveLastModifiedChanged(v); }
                        verifySslChanged(v) => { root.verifySslChanged(v); }
                        nameConflictChanged(v) => { root.nameConflictChanged(v); }
                        useSystemDnsChanged(v) => { root.useSystemDnsChanged(v); }
                        proxyChoice <=> root.proxyChoice;
                        proxyProtocolIndex <=> root.proxyProtocolIndex;
                        proxyHost <=> root.proxyHost;
                        proxyPort <=> root.proxyPort;
                        proxyUser <=> root.proxyUser;
                        proxyPass <=> root.proxyPass;
                        proxyChoiceChanged(c) => { root.proxyChoiceChanged(c); }
                        proxyFieldsChanged(p, h, t, u, w) => { root.proxyFieldsChanged(p, h, t, u, w); }
                        aria2Enabled <=> root.aria2Enabled;
                        aria2RpcPort <=> root.aria2RpcPort;
                        aria2RpcToken <=> root.aria2RpcToken;
                        aria2EmulateFingerprint <=> root.aria2EmulateFingerprint;
                        aria2EnabledChanged(v) => { root.aria2EnabledChanged(v); }
                        aria2RpcPortChanged(v) => { root.aria2RpcPortChanged(v); }
                        aria2RpcTokenChanged(t) => { root.aria2RpcTokenChanged(t); }
                        aria2EmulateFingerprintChanged(v) => { root.aria2EmulateFingerprintChanged(v); }
                        browserEnabled <=> root.browserEnabled;
                        browserDraftTaken <=> root.browserDraftTaken;
                        browserPort <=> root.browserPort;
                        browserEnabledChanged(v) => { root.browserEnabledChanged(v); }
                        browserDraftTakenChanged(v) => { root.browserDraftTakenChanged(v); }
                        browserPortChanged(v) => { root.browserPortChanged(v); }
                        copyPairToken() => { root.copyPairToken(); }
                        regeneratePairToken() => { root.regeneratePairToken(); }
                        openStoreUrl(url) => { root.openStoreUrl(url); }
                        chromiumInstall() => { root.chromiumInstall(); }
                        clientProfileIndex <=> root.clientProfileIndex;
                        clientProfileChanged(i) => { root.clientProfileChanged(i); }
                        headersPresetNames <=> root.headersPresetNames;
                        headersPresetIndex <=> root.headersPresetIndex;
                        headersPresetHeaderCount <=> root.headersPresetHeaderCount;
                        headersPresetCanRemove <=> root.headersPresetCanRemove;
                        headersPresetPicked(i) => { root.headersPresetPicked(i); }
                        headersPresetRemoveRequested(i) => { root.headersPresetRemoveRequested(i); }
                        identityPresets <=> root.identityPresets;
                        identityPresetToggled(i, v) => { root.identityPresetToggled(i, v); }
                        identityPresetRemoveRequested(i) => { root.identityPresetRemoveRequested(i); }
                        identityEditVisible <=> root.identityEditVisible;
                        identityEditIndex <=> root.identityEditIndex;
                        identityEditName <=> root.identityEditName;
                        identityEditHosts <=> root.identityEditHosts;
                        identityEditHostsError <=> root.identityEditHostsError;
                        identityEditProfile <=> root.identityEditProfile;
                        identityEditProfileIndex <=> root.identityEditProfileIndex;
                        identityEditProfileLabels <=> root.identityEditProfileLabels;
                        identityEditProfileValues <=> root.identityEditProfileValues;
                        identityEditUserAgent <=> root.identityEditUserAgent;
                        identityEditHelpVisible <=> root.identityEditHelpVisible;
                        identityPresetAddRequested() => { root.identityPresetAddRequested(); }
                        identityPresetEditRequested(i) => { root.identityPresetEditRequested(i); }
                        identityPresetEditClosed() => { root.identityPresetEditClosed(); }
                        identityPresetEditAccepted(d) => { root.identityPresetEditAccepted(d); }
                        categoryRows <=> root.categoryRows;
                        categoryRuleCount <=> root.categoryRuleCount;
                        categoryResetRequested() => { root.categoryResetRequested(); }
                        categoryRemoveRequested(id) => { root.categoryRemoveRequested(id); }
                        categoryIconChoices <=> root.categoryIconChoices;
                        categoryEditVisible <=> root.categoryEditVisible;
                        categoryEditId <=> root.categoryEditId;
                        categoryEditName <=> root.categoryEditName;
                        categoryEditIconIndex <=> root.categoryEditIconIndex;
                        categoryEditExtensions <=> root.categoryEditExtensions;
                        categoryEditFolder <=> root.categoryEditFolder;
                        categoryAddRequested() => { root.categoryAddRequested(); }
                        categoryEditRequested(id) => { root.categoryEditRequested(id); }
                        categoryEditClosed() => { root.categoryEditClosed(); }
                        categoryEditAccepted(d) => { root.categoryEditAccepted(d); }
                        headersEditVisible <=> root.headersEditVisible;
                        headersEditIndex <=> root.headersEditIndex;
                        headersEditName <=> root.headersEditName;
                        headersEditPairs <=> root.headersEditPairs;
                        headersEditNameError <=> root.headersEditNameError;
                        headersEditDuplicateWarning <=> root.headersEditDuplicateWarning;
                        headersPresetAddRequested() => { root.headersPresetAddRequested(); }
                        headersPresetEditRequested(i) => { root.headersPresetEditRequested(i); }
                        headersPresetEditClosed() => { root.headersPresetEditClosed(); }
                        headersPresetEditAccepted(d) => { root.headersPresetEditAccepted(d); }
                        headersPresetPairsEdited(text) => { root.headersPresetPairsEdited(text); }
                        exportCrx() => { root.exportCrx(); }
                        urlSchemeEnabled <=> root.urlSchemeEnabled;
                        checkUpdateAtStartup <=> root.checkUpdateAtStartup;
                        runAtLogin <=> root.runAtLogin;
                        closeModeIndex <=> root.closeModeIndex;
                        clipboardListener <=> root.clipboardListener;
                        urlSchemeEnabledChanged(v) => { root.urlSchemeEnabledChanged(v); }
                        checkUpdateAtStartupChanged(v) => { root.checkUpdateAtStartupChanged(v); }
                        runAtLoginChanged(v) => { root.runAtLoginChanged(v); }
                        closeModeChanged(i) => { root.closeModeChanged(i); }
                        clipboardListenerChanged(v) => { root.clipboardListenerChanged(v); }
                        uiScalePercent <=> root.uiScalePercent;
                        uiScaleChanged(v) => { root.uiScaleChanged(v); }
                    }
                }
            }
        }

        // ---- 通知条：贴在标题栏下方（镜像 `InfoBar` 加进主布局）----
        if root.infoBarVisible : ShellInfoBar {
            x: 190px + 16px;
            y: 48px + 8px;
            width: parent.width - 190px - 32px;
            title: root.infoBarTitle;
            text: root.infoBarText;
            buttons: root.infoBarButtons;
            buttonClicked(index) => {
                root.infoBarButtonClicked(index);
            }
            closeRequested => {
                root.infoBarClosed();
            }
        }

        // 第 53 步：任务抽屉（自带遮罩 + 滑入动画）。属性全部来自
        // `open_task_drawer` 的派生结果；这里只做单向装配与回调转发。
        // 关闭按钮/遮罩点击**自行收起**（镜像 Qt `reject()`），同时通知
        // 调用方——与第 47 步身份覆盖层「不自行收起」的差异在于这里
        // 没有校验需要保持打开。
        TaskDrawer {
            opened: root.drawerVisible;
            taskId: root.drawerTaskId;
            taskName: root.drawerTaskName;
            progressValue: root.drawerProgressValue;
            progressVisible: root.drawerProgressVisible;
            progressError: root.drawerProgressError;
            statusText: root.drawerStatusText;
            errorVisible: root.drawerErrorVisible;
            errorTitle: root.drawerErrorTitle;
            errorText: root.drawerErrorText;
            infoRows: root.drawerInfoRows;
            checksumVisible: root.drawerChecksumVisible;
            checksumRows: root.drawerChecksumRows;
            checksumError: root.drawerChecksumError;
            checksumMatched: root.drawerChecksumMatched;
            checksumTooltip: root.drawerChecksumTooltip;
            expectedChecksum <=> root.drawerExpectedChecksum;
            fileListVisible: root.drawerFileListVisible;
            fileRows: root.drawerFileRows;
            closeRequested(taskId) => {
                root.drawerVisible = false;
                root.drawerCloseRequested(taskId);
            }
            expectedChecksumEdited(taskId, text) => {
                root.drawerExpectedChecksumEdited(taskId, text);
            }
            pasteChecksumRequested(taskId) => {
                root.drawerPasteChecksumRequested(taskId);
            }
            copyTextRequested(taskId, text) => {
                root.drawerCopyTextRequested(taskId, text);
            }
            revealInFolderRequested(taskId) => {
                root.drawerRevealInFolderRequested(taskId);
            }
        }

        // ---- 消息框（close-ask / exception / pair 共用）----
        ShellMessageDialog {
            width: 100%;
            height: 100%;
            opened: root.dialogVisible;
            title: root.dialogTitle;
            text: root.dialogText;
            checkboxLabel: root.dialogCheckboxLabel;
            checkboxChecked <=> root.dialogCheckboxChecked;
            buttons: root.dialogButtons;
            buttonClicked(index) => {
                root.dialogButtonClicked(index);
            }
            checkboxToggled(checked) => {
                root.dialogCheckboxToggled(checked);
            }
        }

        // ---- 扩展安装引导框（P3 第 123 步）----
        // 与 Qt 的差别：`yesButton.clicked.disconnect()` 之后 yes 只做副作用、**不关框**，
        // 所以 `confirmed` 不改 `extensionInstallVisible`（见 `extension_install.rs`）。
        ExtensionInstallDialog {
            width: 100%;
            height: 100%;
            opened: root.extensionInstallVisible;
            title: root.extensionInstallTitle;
            steps: root.extensionInstallSteps;
            preview-text: root.extensionInstallPreviewText;
            yes-text: root.extensionInstallYesText;
            cancel-text: root.extensionInstallCancelText;
            confirmed => {
                root.extensionInstallConfirmed();
            }
            dismissed => {
                root.extensionInstallDismissed();
            }
        }

        // ---- 卡片右键菜单（`RoundMenu`）----
        // 覆盖层铺满窗口：点空白关闭，面板吞点击。
        CardMenuPopup {
            width: 100%;
            height: 100%;
            opened: root.cardMenuOpened;
            anchorX: root.cardMenuX;
            anchorY: root.cardMenuY;
            panelHeight: root.cardMenuHeight;
            rows: root.cardMenuRows;
            activated(index) => {
                root.cardMenuActivated(index);
            }
            dismissed => {
                root.cardMenuDismissed();
            }
        }

        // ---- 拖放区（镜像 `dragEnterEvent` / `dropEvent`）----
        DropArea {
            width: 100%;
            height: 100%;
            can-drop(event) => {
                root.canDropPayload(event.data) ? DragAction.copy : DragAction.none
            }
            dropped(event) => {
                root.dropPayload(event.data);
                return event.proposed-action;
            }
        }
    }
}