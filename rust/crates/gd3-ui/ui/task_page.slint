// 任务列表页（Phase 7b 起步）：先固化「行数据契约」，Qt 视觉（卡片/图标/
// 进度环）逐页迁移时再展开。行字段对齐 app/view/pages/task_page.py +
// app/view/cards/task_cards.py 的最小展示集。
//
// 文案（状态/进度/速度）由调用方（Rust 或 Python 桥）给出；Slint 侧
// 不管格式化语义——与「兜底不在核心层」同一分层原则。
//
// 筛选口径（对齐 task_page.py ROUTE_TO_FILTER，45-47 行）：段按钮固定
// 发出 "all"/"active"/"completed" 字面量；filterMode 属性由调用方
// 回写（Rust 侧 FilterMode 状态推回）供后续高亮。搜索/暂停/删除的
// 执行都在调用方，Slint 只发字面量。

import { ListView, VerticalBox, HorizontalBox, LineEdit, Button, ComboBox, ProgressIndicator } from "std-widgets.slint";

export struct TaskRow {
    taskId: string,
    name: string,
    statusText: string,
    progressText: string,
    // 结构化渲染字段（第 29 步）：status 为磁盘持久化枚举名（
    // TaskStatus.name 口径，供状态色/控件可见性派发）；progress 为
    // 0-100 百分比（std ProgressIndicator 契约 0-1，行内 /100 换算）。
    status: string,
    progress: float,
}

// 段按钮（Python SegmentedToggleToolWidget 最小同构）：选中段高亮，
// 点击只发路由字面量（图标/tooltip 等视觉细节留主题对齐步）。
component SegmentItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 28px;
    border-radius: 6px;
    // 第 30 步临时色，主题对齐步再换。
    background: self.selected ? #E2E6ED : transparent;
    horizontal-stretch: 0;

    Text {
        text: root.label;
        vertical-alignment: center;
        font-size: 13px;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component TaskPage inherits Rectangle {
    in property <[TaskRow]> tasks;
    in property <string> searchText: "";
    in property <string> filterMode: "all";
    in property <[string]> categoryNames;
    in property <bool> categoryEnabled: false;
    in-out property <int> categoryIndex: 0;
    // 段高亮（第 30 步）：由 AppWindow 层按 filterMode 统一派生后
    // 单向传入（双链初值竞态实证会互相覆盖）。slint 侧不做未知
    // 字面量容错（全不选中），容错语义在 filter.rs 镜像层。
    in property <bool> highlightAll;
    in property <bool> highlightActive;
    in property <bool> highlightCompleted;
    in property <string> searchPlaceholder: "搜索任务";
    // 排序（镜像 Python sortMenu：缺省 CREATED_AT + 倒序）。索引即
    // 菜单显示序，映射在 Rust 侧 sort::from_menu_index。
    in-out property <int> sortFieldIndex: 0;
    in-out property <int> sortOrderIndex: 1;

    callback searchChanged(string);
    callback filterModeChanged(string);
    callback taskPause(string);
    callback taskDelete(string);
    callback categoryFilterChanged(int);
    callback sortFieldChanged(int);
    callback sortOrderChanged(int);

    background: transparent;

    VerticalBox {
        HorizontalBox {
            SegmentItem {
                label: "全部";
                selected: root.highlightAll;
                clicked => { root.filterModeChanged("all"); }
            }
            SegmentItem {
                label: "进行中";
                selected: root.highlightActive;
                clicked => { root.filterModeChanged("active"); }
            }
            SegmentItem {
                label: "已完成";
                selected: root.highlightCompleted;
                clicked => { root.filterModeChanged("completed"); }
            }
            ComboBox {
                model: root.categoryNames;
                current-index <=> root.categoryIndex;
                visible: root.categoryEnabled;
                selected => { root.categoryFilterChanged(self.current-index); }
            }
            ComboBox {
                model: ["按添加时间", "按完成时间", "按名称排序", "按大小排序", "按队列顺序"];
                current-index <=> root.sortFieldIndex;
                selected => { root.sortFieldChanged(self.current-index); }
            }
            ComboBox {
                model: ["顺序", "倒序"];
                current-index <=> root.sortOrderIndex;
                selected => { root.sortOrderChanged(self.current-index); }
            }
            LineEdit {
                placeholder-text: root.searchPlaceholder;
                text: root.searchText;
                edited(text) => { root.searchChanged(text); }
                accepted(text) => { root.searchChanged(text); }
            }
        }

        Text {
            // filterMode 属性行当前只供调用方/测试回写读校；段高亮在
            // 视觉接近平卡片的后续步再展开（Qt 侧是段控件）。
            text: root.filterMode;
            font-size: 11px;
        }

        ListView {
            for row in root.tasks: Rectangle {
                height: 32px;

                HorizontalBox {
                    // 状态色点（第 29 步临时色，主题对齐在后续视觉步）。
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: 12px;
                        border-radius: 4px;
                        background: row.status == "RUNNING" ? #3477FF
                            : row.status == "COMPLETED" ? #30BE60
                            : row.status == "FAILED" ? #F5403C
                            : row.status == "PAUSED" ? #FFC107
                            : #858585;
                    }
                    Text {
                        vertical-alignment: center;
                        text: row.name;
                    }
                    // 进度条：仅 RUNNING 显示（Python 卡片 RUNNING 走
                    // 进度条、其余走 statusLabel 的同款分发）。
                    ProgressIndicator {
                        progress: row.progress / 100;
                        visible: row.status == "RUNNING";
                    }
                    Text {
                        vertical-alignment: center;
                        text: row.statusText;
                        font-size: 12px;
                    }
                    Text {
                        vertical-alignment: center;
                        text: row.progressText;
                        font-size: 12px;
                    }
                }
            }
        }
    }
}
