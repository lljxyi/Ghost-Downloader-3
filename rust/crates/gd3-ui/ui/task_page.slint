// 任务列表页（Phase 7b 起步 + 第 51 步接卡片派生层）。行字段对齐
// app/view/cards/task_cards.py（`card.rs` 是它的语义镜像）。
//
// 文案（状态行/信息行/按钮图标）全部由调用方（`card.rs` + `row.rs`）算好，
// Slint 侧不管格式化语义——与「兜底不在核心层」同一分层原则。Slint 只做
// 三件事：按 `*Visible` 显示/隐藏、按 `*Enabled` 启用、点击发 taskId 字面量。
//
// 图标：Qt 侧是 FluentIcon 枚举，这里只拿到名字（"PLAY"/"PAUSE"…），
// 主题对齐步再换成矢量资源；当前用文字占位（VPS-MIGRATION.md 明确「语义
// 镜像、不追求像素一致」）。
//
// 筛选口径（对齐 task_page.py ROUTE_TO_FILTER，45-47 行）：段按钮固定
// 发出 "all"/"active"/"completed" 字面量；filterMode 属性由调用方
// 回写（Rust 侧 FilterMode 状态推回）供后续高亮。搜索/暂停/删除的
// 执行都在调用方，Slint 只发字面量。

import { ListView, VerticalBox, HorizontalBox, LineEdit, Button, ComboBox, ProgressIndicator } from "std-widgets.slint";

export struct TaskRow {
    taskId: string,
    name: string,
    // 磁盘持久化枚举名（TaskStatus.name 口径），供状态色派发。
    status: string,
    // 信息行三段（`TaskCard.infoFields`：speed / eta / size）。Python 只有
    // 「有格式化函数且返回非 None」才 show()，故 text 与 visible 一一对应。
    speedText: string,
    speedVisible: bool,
    etaText: string,
    etaVisible: bool,
    sizeText: string,
    sizeVisible: bool,
    // 状态行（`_refreshForStatus`）。RUNNING 时整段隐藏（Python statusLabel.hide()）。
    statusLine: string,
    statusLineVisible: bool,
    // 「文件不存在」走告警色（QColor(200,160,80)）。
    statusWarn: bool,
    // 进度条（`_createProgressBar` + show/hide/setError）。
    // progressValue 是 Python `setValue(int(progress))` 的整数口径。
    progressValue: int,
    progressIndeterminate: bool,
    progressVisible: bool,
    progressError: bool,
    // 四个带 states 的按钮（`_refreshButtons`）。toggleIcon 是生效图标名。
    toggleIcon: string,
    toggleEnabled: bool,
    selectFilesVisible: bool,
    checksumVisible: bool,
    checksumEnabled: bool,
    openFileEnabled: bool,
}

// 段按钮（Python SegmentedToggleToolWidget 最小同构）：选中段高亮，
// 点击只发路由字面量（图标/tooltip 等视觉细节留主题对齐步）。
component SegmentItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 28px;
    border-radius: 6px;
    // 第 30 步临时色，主题对齐步再换。
    background: self.selected ? #E2E6ED : transparent;
    horizontal-stretch: 0;

    Text {
        text: root.label;
        vertical-alignment: center;
        font-size: 13px;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// 卡片上的小按钮（PrimaryToolButton / TransparentToolButton 最小同构）。
component CardButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 24px;
    width: 52px;
    border-radius: 4px;
    background: self.enabled ? #F3F5F8 : #F7F7F7;
    opacity: self.enabled ? 1.0 : 0.5;

    Text {
        text: root.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 11px;
        color: #3A3A3A;
    }
    TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

export component TaskPage inherits Rectangle {
    in property <[TaskRow]> tasks;
    in property <string> searchText: "";
    in property <string> filterMode: "all";
    in property <[string]> categoryNames;
    in property <bool> categoryEnabled: false;
    in-out property <int> categoryIndex: 0;
    // 段高亮（第 30 步）：由 AppWindow 层按 filterMode 统一派生后
    // 单向传入（双链初值竞态实证会互相覆盖）。slint 侧不做未知
    // 字面量容错（全不选中），容错语义在 filter.rs 镜像层。
    in property <bool> highlightAll;
    in property <bool> highlightActive;
    in property <bool> highlightCompleted;
    in property <string> searchPlaceholder: "搜索任务";
    // 排序（镜像 Python sortMenu：缺省 CREATED_AT + 倒序）。索引即
    // 菜单显示序，映射在 Rust 侧 sort::from_menu_index。
    in-out property <int> sortFieldIndex: 0;
    in-out property <int> sortOrderIndex: 1;

    callback searchChanged(string);
    callback filterModeChanged(string);
    callback taskPause(string);
    callback taskDelete(string);
    // 第 51 步：卡片按钮。Slint 只发 taskId，语义在调用方
    // （toggle 按状态分派暂停/继续/做种，镜像 `_onToggleClicked`）。
    callback taskToggle(string);
    callback taskSelectFiles(string);
    callback taskChecksum(string);
    callback taskOpenFile(string);
    callback taskOpenFolder(string);
    // 第 53 步：打开任务详情抽屉（镜像卡片右键「任务详情」与点信息区
    // 触发 `_openDrawer`）。Slint 只发 taskId，装配在调用方。
    callback taskOpenDrawer(string);
    callback categoryFilterChanged(int);
    callback sortFieldChanged(int);
    callback sortOrderChanged(int);

    background: transparent;

    VerticalBox {
        HorizontalBox {
            SegmentItem {
                label: "全部";
                selected: root.highlightAll;
                clicked => { root.filterModeChanged("all"); }
            }
            SegmentItem {
                label: "进行中";
                selected: root.highlightActive;
                clicked => { root.filterModeChanged("active"); }
            }
            SegmentItem {
                label: "已完成";
                selected: root.highlightCompleted;
                clicked => { root.filterModeChanged("completed"); }
            }
            ComboBox {
                model: root.categoryNames;
                current-index <=> root.categoryIndex;
                visible: root.categoryEnabled;
                selected => { root.categoryFilterChanged(self.current-index); }
            }
            ComboBox {
                model: ["按添加时间", "按完成时间", "按名称排序", "按大小排序", "按队列顺序"];
                current-index <=> root.sortFieldIndex;
                selected => { root.sortFieldChanged(self.current-index); }
            }
            ComboBox {
                model: ["顺序", "倒序"];
                current-index <=> root.sortOrderIndex;
                selected => { root.sortOrderChanged(self.current-index); }
            }
            LineEdit {
                placeholder-text: root.searchPlaceholder;
                text: root.searchText;
                edited(text) => { root.searchChanged(text); }
                accepted(text) => { root.searchChanged(text); }
            }
        }

        Text {
            // filterMode 属性行当前只供调用方/测试回写读校；段高亮在
            // 视觉接近平卡片的后续步再展开（Qt 侧是段控件）。
            text: root.filterMode;
            font-size: 11px;
        }

        ListView {
            for row in root.tasks: Rectangle {
                height: 56px;
                border-radius: 6px;
                background: #FFFFFF;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;

                    // 状态色点（第 29 步临时色，主题对齐在后续视觉步）。
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: row.status == "RUNNING" ? #3477FF
                            : row.status == "COMPLETED" ? #30BE60
                            : row.status == "FAILED" ? #F5403C
                            : row.status == "PAUSED" ? #FFC107
                            : #858585;
                    }

                    // 名称 + 信息行（speed / eta）。
                    VerticalLayout {
                        horizontal-stretch: 1.0;
                        Text {
                            vertical-alignment: center;
                            text: row.name;
                            font-size: 13px;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                vertical-alignment: center;
                                text: row.speedText;
                                visible: row.speedVisible;
                                font-size: 11px;
                                color: #666666;
                            }
                            Text {
                                vertical-alignment: center;
                                text: row.etaText;
                                visible: row.etaVisible;
                                font-size: 11px;
                                color: #666666;
                            }
                        }
                    }

                    // 进度条：RUNNING 才 show()、COMPLETED 才 hide()，
                    // 其余状态沿用上一次（`ProgressVisibility::visible()`）。
                    ProgressIndicator {
                        width: 120px;
                        // progressValue 是 0-100 的 int；先乘 1.0 转 float
                        // 再除（Slint 里 int/int 是整除，直接除会恒得 0/1）。
                        progress: row.progressValue * 1.0 / 100.0;
                        indeterminate: row.progressIndeterminate;
                        visible: row.progressVisible;
                    }

                    // 大小 + 状态行。
                    VerticalLayout {
                        horizontal-stretch: 1.0;
                        Text {
                            vertical-alignment: center;
                            text: row.sizeText;
                            visible: row.sizeVisible;
                            font-size: 12px;
                        }
                        Text {
                            vertical-alignment: center;
                            text: row.statusLine;
                            visible: row.statusLineVisible;
                            font-size: 12px;
                            color: row.statusWarn ? #C8A050 : #666666;
                        }
                    }

                    CardButton {
                        label: row.toggleIcon;
                        enabled: row.toggleEnabled;
                        clicked => { root.taskToggle(row.taskId); }
                    }
                    CardButton {
                        label: "选择文件";
                        visible: row.selectFilesVisible;
                        clicked => { root.taskSelectFiles(row.taskId); }
                    }
                    CardButton {
                        label: "校验";
                        visible: row.checksumVisible;
                        enabled: row.checksumEnabled;
                        clicked => { root.taskChecksum(row.taskId); }
                    }
                    CardButton {
                        label: "打开文件";
                        enabled: row.openFileEnabled;
                        clicked => { root.taskOpenFile(row.taskId); }
                    }
                    CardButton {
                        label: "打开文件夹";
                        clicked => { root.taskOpenFolder(row.taskId); }
                    }
                    // 第 53 步：「详情」入口（镜像卡片右键「任务详情」与点
                    // 信息区触发 `_openDrawer`；Slint 侧用显式按钮等价表达）。
                    CardButton {
                        label: "详情";
                        clicked => { root.taskOpenDrawer(row.taskId); }
                    }
                    CardButton {
                        label: "删除";
                        clicked => { root.taskDelete(row.taskId); }
                    }
                }
            }
        }
    }
}
