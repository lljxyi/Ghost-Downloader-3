// 任务草稿对话框（P2，第 125 步）。
//
// 镜像 `app/view/dialogs/task_draft.py` 的 `TaskDraftDialog`（349 行）+
// `DraftCardGroup` / `OptionCardGroup`（card_groups.py）+ `DraftCard`（draft_cards.py）。
// 这一层只做**形状**：标题行 + 多行 URL 编辑器 + 解析进度条 + 解析结果列表 +
// 两个下载设置 + 底部三个按钮。文案、行内容、统计标签的可见性全部由 Rust 侧
// `gd3-ui::task_draft_ui`（`TaskDraftUi` / `DraftView`）给出，这里不判断业务语义，
// 也不硬编码一个字。
//
// 与 Qt 侧的形状差异（语义不变，见 `task_draft_ui.rs` 的「已知差异」）：
// - `MessageBoxBase.exec()` 的模态事件循环换成 `opened` 覆盖层 + 回调；
// - 不确定进度条是**静态**的 40% 填充（Slint 侧没有 `IndeterminateProgressBar`，
//   可见性仍然等价：`parsing` 为真才显示）；
// - `PrimarySplitPushButton` 的「下载 + 下拉」拆成两个按钮（下载 / 稍后下载）；
// - 文件图标只有占位字形（`QFileIconProvider` 的按扩展名图标未镜像）；
// - `FolderPicker` 的输入框 + 历史下拉简化为输入框 + 浏览按钮；
// - 圆角/阴影/主题色留给主题对齐步。

import { Slider, TextEdit } from "std-widgets.slint";
import { ShellButton } from "app_shell.slint";

// 一行解析结果（`DraftCard` 的可见字段）。
// `url` 是 `_cardByUrl` 的键，也是行级回调的参数。
export struct DraftRowData {
    url: string,
    name: string,
    // `toReadableSize(fileSize) if fileSize > 1 else "--"`（draft_cards.py:40）。
    size: string,
    // 分类按钮的提示文案（`toCategoryName` / `未分类`）。
    category: string,
    category-visible: bool,
    // `_probeConflict(task) is not None`。
    conflict: bool,
    // `task.canEdit`。
    editable: bool,
}

export component TaskDraftDialog inherits Rectangle {
    in property <bool> opened: false;
    in property <string> title: "添加任务";
    // `urlEdit.setPlaceholderText(...)`。
    in property <string> placeholder: "";
    in property <string> batch-text: "批量添加";
    in property <string> import-text: "导入文件";
    // `importButton.setVisible(bool(self._fileTypes))`。
    in property <bool> import-visible: true;
    // `urlEdit.toPlainText()` 的双向绑定：编辑后由 Rust 侧做 1 秒防抖。
    in-out property <string> url-text: "";
    // `progressBar.setVisible` 的来源（`parsingBusyChanged`）。
    in property <bool> parsing: false;

    // ---- 解析结果分组（`DraftCardGroup`）----
    in property <string> draft-title: "解析结果";
    in property <[DraftRowData]> rows;
    in property <string> ratio-text: "";
    in property <bool> ratio-visible: false;
    in property <string> size-text: "";
    in property <bool> size-visible: false;

    // ---- 下载设置分组（`OptionCardGroup`）----
    in property <string> options-title: "下载设置";
    in property <string> folder-title: "选择下载路径";
    in property <string> folder-browse-text: "浏览";
    in-out property <string> folder-text: "";
    in property <string> subworker-title: "预分配线程数";
    // `Slider.value` 是 float，这里也存 float 才能双向绑定（`<=>` 要求同型）；
    // 显示与回调仍按 int（`SubworkerCountCard.value` 是 i32）。
    in-out property <float> subworker-value: 8;
    in property <int> subworker-min: 1;
    in property <int> subworker-max: 256;

    // ---- 底部按钮 ----
    in property <string> download-text: "下载";
    in property <string> later-text: "稍后下载";
    in property <string> cancel-text: "取消";
    // `_draft.canConfirm()`：没有可下载的条目时主按钮不可点。
    in property <bool> can-confirm: false;

    callback url-edited(string);
    callback batch-clicked;
    callback import-clicked;
    callback folder-edited(string);
    callback folder-pick-requested;
    callback subworker-edited(int);
    callback download-clicked;
    callback later-clicked;
    callback cancel-clicked;
    callback row-edit-requested(string);
    callback row-category-requested(string);

    visible: root.opened;
    background: #33000000;

    // 遮罩吞掉点击（模态）。
    TouchArea {}

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 48px, 700px);
        height: min(parent.height - 48px, 640px);
        border-radius: 8px;
        background: white;
        border-width: 1px;
        border-color: #e0e0e0;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            // ---- 标题行：标题 + 弹性空隙 + 批量添加 + 导入文件 ----
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.title;
                    font-size: 16px;
                    font-weight: 700;
                    color: #1a1a1a;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                ShellButton {
                    text: root.batch-text;
                    clicked => {
                        root.batch-clicked();
                    }
                }
                if root.import-visible : ShellButton {
                    text: root.import-text;
                    clicked => {
                        root.import-clicked();
                    }
                }
            }

            // ---- 多行 URL 编辑器（`AutoSizingEdit`，NoWrap）----
            Rectangle {
                height: 96px;
                border-radius: 5px;
                background: #fbfbfb;
                border-width: 1px;
                border-color: #dcdcdc;

                TextEdit {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    height: parent.height - 16px;
                    text <=> root.url-text;
                    placeholder-text: root.placeholder;
                    wrap: no-wrap;
                    font-size: 13px;
                    edited => {
                        root.url-edited(self.text);
                    }
                }
            }

            // ---- 不确定进度条（`IndeterminateProgressBar`）----
            // 只在解析中显示；Slint 侧没有等价的不确定动画，用静态填充表达。
            Rectangle {
                height: 3px;
                background: #e6e6e6;
                visible: root.parsing;
                Rectangle {
                    width: 40%;
                    height: 100%;
                    background: #0067c0;
                }
            }

            // ---- 解析结果分组 ----
            Rectangle {
                vertical-stretch: 1;
                min-height: 30px;
                border-radius: 5px;
                background: #fafafa;
                border-width: 1px;
                border-color: #e5e5e5;

                VerticalLayout {
                    padding: 0px;

                    // 标题行（`headerLabel` 30px + 右侧两个统计标签）。
                    HorizontalLayout {
                        height: 30px;
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 8px;
                        Text {
                            text: root.draft-title;
                            font-size: 13px;
                            color: #1a1a1a;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.ratio-visible : Text {
                            text: root.ratio-text;
                            font-size: 13px;
                            color: #c43501;
                            vertical-alignment: center;
                        }
                        if root.size-visible : Text {
                            text: root.size-text;
                            font-size: 13px;
                            color: #555;
                            vertical-alignment: center;
                        }
                        // `_rightPad`（`QLabel("  ")`）。
                        Text {
                            text: "  ";
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    // 卡片列表：最多显示 5 张（`MIN_VISIBLE = 5`），再多滚动。
                    Flickable {
                        width: 100%;
                        height: min(root.rows.length * 35px, 175px);
                        content-width: self.width;
                        content-height: row-list.preferred-height;
                        interactive: row-list.preferred-height > self.height;

                        row-list := VerticalLayout {
                            width: parent.width;
                            for row in root.rows : Rectangle {
                                height: 35px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    // 文件类型图标（Qt 侧是 `QFileIconProvider`，这里用占位字形）。
                                    Text {
                                        text: "▤";
                                        font-size: 12px;
                                        color: #666;
                                        width: 16px;
                                        height: 16px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: row.name;
                                        font-size: 13px;
                                        color: #1a1a1a;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    // `conflictIcon`：下载目录已有同名文件。
                                    Text {
                                        text: "!";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #c43501;
                                        width: 16px;
                                        height: 16px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        visible: row.conflict;
                                    }
                                    Text {
                                        text: row.size;
                                        font-size: 13px;
                                        color: #444;
                                        vertical-alignment: center;
                                    }
                                    // `editButton`（`FluentIcon.EDIT`，28×28）。
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 4px;
                                        background: edit-touch.has-hover ? #e8e8e8 : transparent;
                                        visible: row.editable;

                                        Text {
                                            text: "✎";
                                            font-size: 13px;
                                            color: #444;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        edit-touch := TouchArea {
                                            clicked => {
                                                root.row-edit-requested(row.url);
                                            }
                                        }
                                    }
                                    // `categoryButton`（`FluentIcon.TAG`，28×28）。
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 4px;
                                        background: category-touch.has-hover ? #e8e8e8 : transparent;
                                        visible: row.category-visible;

                                        Text {
                                            text: "🏷";
                                            font-size: 13px;
                                            color: #444;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        category-touch := TouchArea {
                                            clicked => {
                                                root.row-category-requested(row.url);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ---- 下载设置分组 ----
            Rectangle {
                min-height: 30px;
                border-radius: 5px;
                background: #fafafa;
                border-width: 1px;
                border-color: #e5e5e5;

                VerticalLayout {
                    padding: 0px;

                    HorizontalLayout {
                        height: 30px;
                        padding-left: 4px;
                        spacing: 8px;
                        Text {
                            text: root.options-title;
                            font-size: 13px;
                            color: #1a1a1a;
                            vertical-alignment: center;
                        }
                    }

                    // `OutputFolderCard`（固定高 50，左右 24、上下 5，间距 15）。
                    HorizontalLayout {
                        height: 50px;
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 15px;
                        Text {
                            text: "⤓";
                            font-size: 13px;
                            color: #444;
                            width: 16px;
                            height: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.folder-title;
                            font-size: 13px;
                            color: #1a1a1a;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 300px;
                            height: 28px;
                            border-radius: 4px;
                            background: white;
                            border-width: 1px;
                            border-color: #dcdcdc;

                            TextEdit {
                                x: 6px;
                                y: 4px;
                                width: parent.width - 12px;
                                height: parent.height - 8px;
                                text <=> root.folder-text;
                                wrap: no-wrap;
                                font-size: 12px;
                                edited => {
                                    root.folder-edited(self.text);
                                }
                            }
                        }
                        ShellButton {
                            text: root.folder-browse-text;
                            clicked => {
                                root.folder-pick-requested();
                            }
                        }
                    }

                    // `SubworkerCountCard`（`预分配线程数` + 数值 + 滑杆）。
                    HorizontalLayout {
                        height: 50px;
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 15px;
                        Text {
                            text: "☁";
                            font-size: 13px;
                            color: #444;
                            width: 16px;
                            height: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.subworker-title;
                            font-size: 13px;
                            color: #1a1a1a;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: "\{round(root.subworker-value)}";
                            font-size: 13px;
                            color: #1a1a1a;
                            vertical-alignment: center;
                        }
                        Slider {
                            width: 268px;
                            minimum: root.subworker-min;
                            maximum: root.subworker-max;
                            step: 1;
                            value <=> root.subworker-value;
                            changed(value) => {
                                root.subworker-edited(round(value));
                            }
                        }
                    }
                }
            }

            // ---- 底部：下载（主）/ 稍后下载 / 取消 ----
            HorizontalLayout {
                spacing: 12px;
                alignment: end;
                ShellButton {
                    text: root.download-text;
                    primary: true;
                    enabled: root.can-confirm;
                    clicked => {
                        root.download-clicked();
                    }
                }
                ShellButton {
                    text: root.later-text;
                    enabled: root.can-confirm;
                    clicked => {
                        root.later-clicked();
                    }
                }
                ShellButton {
                    text: root.cancel-text;
                    clicked => {
                        root.cancel-clicked();
                    }
                }
            }
        }
    }
}
