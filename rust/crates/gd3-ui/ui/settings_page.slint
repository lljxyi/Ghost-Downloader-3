// 设置页（Phase 7c，第 32-44 步）：镜像 setting_page.py GeneralDownload
// 组、「启用下载分类」、Aria2 RPC/浏览器扩展/关联/软件组简版卡与浏览器
// 扩展动作卡骨架。控件与标题副标题镜像 .tr 字面量；执行（落盘/生效）
// 全在调用方。限速值 KB/s ⇄ 字节 1/1024 换算在 Rust speed.rs；代理卡
// 拼装/校验镜像在 Rust proxy.rs。
// 契约：Rust 侧 push_settings 写值串/数字派生值；控件只回发变化
// （Line/Spin edited、Switch toggled），映射在 Rust 侧 typed set。

import { VerticalBox, HorizontalBox, LineEdit, SpinBox, Switch, ComboBox, Button } from "std-widgets.slint";

// 第 43 步：身份预设行数据（desc 由 Rust identity.rs 预拼三段）。
export struct IdentityPresetData {
    name: string,
    desc: string,
    enabled: bool,
}

// 第 44 步：库分类规则行数据（desc 由 Rust category.rs summary_of
// 预拼三段摘要；id 为 categoryId，读侧缺省保留空串）。
export struct CategoryRowData {
    name: string,
    desc: string,
    id: string,
}

export component SettingsPage inherits Rectangle {
    // in-out 供 SpinBox/Switch 自身编辑态直写，AppWindow 推送覆盖。
    in-out property <string> downloadFolder: "";
    in-out property <int> maxTaskNum: 3;
    in-out property <int> preBlockNum: 8;
    in-out property <bool> categoryEnabled: false;
    in-out property <int> speedLimitationKb: 4096;
    // 第 34 步：GeneralDownload 组剩余简版键（cfg.py 实证）：
    // AutoSpeedUp 默认 True / MaxReassignSize 默认 512 范围 64-102400
    // 单位 KB（division=1 显示=配置值）/ PreserveLastModified 默认 F /
    // shouldVerifySsl 默认 F / NameConflict 选项 keepBoth-overwrite-ask
    // 缺省 keepBoth（发索引，映射归 Rust conflict.rs）/ Network 组
    // ShouldUseSystemDns 默认 True（仅 UI 归组在 GeneralDownload）。
    in-out property <bool> autoSpeedUp: true;
    in-out property <int> maxReassignSize: 512;
    in-out property <bool> preserveLastModified: false;
    in-out property <bool> verifySsl: false;
    in-out property <int> nameConflictIndex: 0;
    in-out property <bool> useSystemDns: true;
    // 第 35 步：ProxyServer（cfg.py GeneralDownload 缺省 "Auto"）。
    // choice 0 Off/1 Auto/2 自定义；自定义四字段原样串（拼 URL/
    // 校验/写入决策归 Rust proxy.rs + install 层）。
    in-out property <int> proxyChoice: 1;
    in-out property <int> proxyProtocolIndex: 0;
    in-out property <string> proxyHost: "";
    in-out property <string> proxyPort: "";
    in-out property <string> proxyUser: "";
    in-out property <string> proxyPass: "";
    // 第 36 步：Aria2 RPC 兼容组（cfg.py:277-280 实证）：
    // Enabled 默认 F / Port 缺省 16800 范围 1024-65535（division=1
    // 显示=配置值）/ Token 默认 ""（无校验）/ EmulateFingerprint 默认
    // F。Python 端令牌 LineEdit 仅 editingFinished（回车/失焦）落盘，
    // 这里 edited+accepted 均回发、install 层每次写（更新鲜，等价
    // 安全，同代理卡注记；见 lib.rs）。
    in-out property <bool> aria2Enabled: false;
    in-out property <int> aria2RpcPort: 16800;
    in-out property <string> aria2RpcToken: "";
    in-out property <bool> aria2EmulateFingerprint: false;
    // 第 37 步：浏览器扩展组简版三键（cfg.py:268-272 实证）：
    // EnableBrowserExtension 默认 T / EnableRaiseWindowWhenReceiveMsg
    // 默认 F（UI 文案是「接管下载时进入草稿模式」，键名与文案不同源，
    // 注记）/ Browser/Port 缺省 14370 范围 1024-65535。
    in-out property <bool> browserEnabled: true;
    in-out property <bool> browserDraftTaken: false;
    in-out property <int> browserPort: 14370;
    // 第 40 步：浏览器扩展动作卡骨架（cfg.py:269 实证：
    // BrowserExtensionPairToken 缺省 ""；镜像 PrimaryPushSettingCard
    // 配对令牌卡、HyperlinkCard 商店卡三链接、PrimaryPushSettingCard
    // Chromium 一键安装卡+导出 CRX 超链接）。令牌副标题=当前值（镜像
    // setContent(cfg.browserExtensionPairToken.value)）；复制/解包/
    // 拉起浏览器为平台动作（剪贴板/openUrl 归平台桥接步）；重新生成
    // 收 () 动作，调用方生成 + cfg.set + 回推显示（生成口径由
    // gd3-core pair_token::generate 兜，token_urlsafe(16) 等价；
    // 断联已认证会话留引擎桥接步）。
    in-out property <string> pairToken: "";
    // 第 41 步：模拟身份（cfg.py Network/ClientProfile 缺省 "auto"
    // ClientProfileValidator 兜 auto）。ComboBox 镜像
    // IdentitySettingCard buildProfileMenu(includeAuto=True) 菜单：
    // auto（自动（匹配来源）/ raw（不模拟（原样发送）/ 逐家族
    // 「最新」（家族字面量即选项值，profileFamilies() 实测顺序；
    // 特定版本选择/identityPresets 列表编辑与 PresetRowWidget 留
    // 欠账步，引擎解析对接 gd3-net resolve_emulation 已备）。
    // 「全局默认：未被预设匹配时使用」注记并入卡面副标题。
    in-out property <int> clientProfileIndex: 0;
    // 第 42 步：请求标头预设（cfg.py:328-333：Network/HeadersPresets
    // JsonConfigSerializer 存 JSON 串、Network/CurrentHeadersPreset Range
    // 0-99 缺省 0 落盘 "0"；镜像 CollapsibleSettingCard「请求标头预设/
    // 新建任务的标头起点」。std 无 RadioButton，逐行单选退化为
    // ComboBox——预设名即选项；计数/可删派生在 Rust headers.rs，空/
    // 非法串按 HeadersPresetListValidator.correct 兜「默认+BASE_HEADERS」。
    // 逐行编辑/删除 ToolButton 与「添加预设」对话框
    // （HeadersPresetEditDialog + HeadersEditor）留欠账步；删除按钮
    // 作用于当前选中项）。
    in-out property <[string]> headersPresetNames;
    in-out property <int> headersPresetIndex: 0;
    in-out property <int> headersPresetHeaderCount: 0;
    in-out property <bool> headersPresetCanRemove: false;
    // 第 43 步：身份预设列表（cfg.py:334-340 缺省含百度网盘客户端
    // 预设；读盘仅 JSON 反序列化不过 validator.correct。行结构镜像
    // PresetRowWidget：名称+三段描述（Rust identity.rs 预拼）+开关
    // （isEnabled 缺省 T，禁用行透明度已做 opacity 镜像）。删除确认
    // 框归调用方；「添加预设」按钮与 PresetEditDialog 编辑对话框留
    // 欠账步；本卡与第 41 步模拟身份卡同源（IdentitySettingCard），
    // 合并成折叠卡留布局步。
    in-out property <[IdentityPresetData]> identityPresets;
    // 第 44 步：库分类规则行（categoryRules 镜像，缺省八预设）。
    in-out property <[CategoryRowData]> categoryRows;
    in-out property <int> categoryRuleCount: 0;
    // 第 38 步：关联组 urlScheme 静态卡 + 软件组简版（cfg.py 实证）：
    // Browser/UrlSchemeRegistered 默认 T（sys!=darwin 显示）/ Software/
    // CheckUpdateAtStartUp 默认 T / AutoRun 默认 F（应用生效归桥接步）/
    // CloseMode 默认 "Ask" 选项 Ask-Background-Quit（发索引，映射归
    // Rust close_mode.rs）/ ClipboardListener 默认 T（软件组键，安卓端不显示）。
    // 每包关联动态 Switch（featureService packs）与迁移模式 PushCard
    // 留引擎桥接/动作骨架步；zoom/主题/语言留主题布局步。
    in-out property <bool> urlSchemeEnabled: true;
    in-out property <bool> checkUpdateAtStartup: true;
    in-out property <bool> runAtLogin: false;
    in-out property <int> closeModeIndex: 0;
    in-out property <bool> clipboardListener: true;
    // 第 39 步：DpiScale 界面缩放（cfg.py:296：Personalization/DpiScale
    // RangeConfigItem 缺省 0 范围 0-5，PercentSpinBox 显示 *100 步 25%
    // 「0% 为自动」，leaveEvent cfg.set(value/100) 写浮点；窗口属性用
    // 显示口径 %（单位缀名，0-500），换算归 install 层。restart=True
    // 生效重启，本卡只写配置；磁盘串 python str(float) 口径（0.25/
    // 整值补 .0，镜像在 gd3-core get_f64/set_f64）。
    in-out property <int> uiScalePercent: 0;

    callback downloadFolderChanged(string);
    callback maxTaskNumChanged(int);
    callback preBlockNumChanged(int);
    callback categoryEnabledChanged(bool);
    callback speedLimitationChanged(int);
    callback autoSpeedUpChanged(bool);
    callback maxReassignSizeChanged(int);
    callback preserveLastModifiedChanged(bool);
    callback verifySslChanged(bool);
    callback nameConflictChanged(int);
    callback useSystemDnsChanged(bool);
    callback proxyChoiceChanged(int);
    callback proxyFieldsChanged(int, string, string, string, string);
    callback aria2EnabledChanged(bool);
    callback aria2RpcPortChanged(int);
    callback aria2RpcTokenChanged(string);
    callback aria2EmulateFingerprintChanged(bool);
    callback browserEnabledChanged(bool);
    callback browserDraftTakenChanged(bool);
    callback browserPortChanged(int);
    callback clientProfileChanged(int);
    callback headersPresetPicked(int);
    callback headersPresetRemoveRequested(int);
    callback identityPresetToggled(int, bool);
    callback identityPresetRemoveRequested(int);
    // 第 44 步：库分类动作（恢复默认收 ()、删除收 categoryId）
    // ——cfg 写与重推归调用方。
    callback categoryResetRequested();
    callback categoryRemoveRequested(string);
    callback copyPairToken();
    callback regeneratePairToken();
    callback openStoreUrl(string);
    callback chromiumInstall();
    callback exportCrx();
    callback urlSchemeEnabledChanged(bool);
    callback checkUpdateAtStartupChanged(bool);
    callback runAtLoginChanged(bool);
    callback closeModeChanged(int);
    callback clipboardListenerChanged(bool);
    callback uiScaleChanged(int);

    background: transparent;

    VerticalBox {
        // SettingCard 最小同构：标题+副标题+右侧控件。图标留主题步。
        HorizontalBox {
            Text {
                text: "下载路径\n文件默认保存位置";
                vertical-alignment: center;
            }
            LineEdit {
                text: root.downloadFolder;
                edited(text) => { root.downloadFolderChanged(text); }
                accepted(text) => { root.downloadFolderChanged(text); }
            }
        }
        HorizontalBox {
            Text {
                text: "最大任务数\n最多能同时进行的任务数量";
                vertical-alignment: center;
            }
            SpinBox {
                minimum: 1;
                maximum: 10;
                value <=> root.maxTaskNum;
                edited(value) => { root.maxTaskNumChanged(value); }
            }
        }
        HorizontalBox {
            Text {
                text: "预分配线程数\n线程越多，下载越快。线程数大于 64 时，有触发反爬导致文件损坏的风险";
                vertical-alignment: center;
            }
            SpinBox {
                minimum: 1;
                maximum: 256;
                value <=> root.preBlockNum;
                edited(value) => { root.preBlockNumChanged(value); }
            }
        }
        HorizontalBox {
            Text {
                text: "启用下载分类\n根据扩展名将下载任务归类，便于筛选与分发到指定文件夹";
                vertical-alignment: center;
            }
            Switch {
                checked <=> root.categoryEnabled;
                toggled => { root.categoryEnabledChanged(self.checked); }
            }
        }
        // 第 44 步：库分类规则行列表（镜像 categoryRulesCard 内
        // CategoryRowWidget 行摘要）。「删除」回发 categoryId、「恢复
        // 默认」回发 ()；cfg 写与 categoriesChanged 重推归调用方；添加
        // /编辑对话框（CategoryEditDialog）与拖拽排序留欠账步。
        VerticalBox {
            for row[r] in root.categoryRows: HorizontalBox {
                Text {
                    text: row.name + "\n" + row.desc;
                    vertical-alignment: center;
                }
                Button {
                    text: "删除";
                    clicked => { root.categoryRemoveRequested(row.id); }
                }
            }
            HorizontalBox {
                Text {
                    text: "共 \{root.categoryRuleCount} 个分类";
                    vertical-alignment: center;
                }
                Button {
                    text: "恢复默认";
                    clicked => { root.categoryResetRequested(); }
                }
            }
        }
        // 第 33 步：SpeedLimitation 卡。SpinBox 显示 KB/s（配置存字
        // 节，1/1024 换算在 Rust speed.rs 镜像层）；std SpinBox 无
        // suffix 属性，后缀走独立 Text。
        HorizontalBox {
            Text {
                text: "下载限速\n当下载任务界面限速开关开启时，所有任务将根据此值进行限速";
                vertical-alignment: center;
            }
            SpinBox {
                minimum: 1;
                maximum: 102400;
                step-size: 512;
                value <=> root.speedLimitationKb;
                edited(value) => { root.speedLimitationChanged(value); }
            }
            Text {
                text: " KB/s";
                vertical-alignment: center;
            }
        }
        // 第 34 步：GeneralDownload 组剩余简版卡（卡序与 Python 组内
        // 顺序不一一对应，全量重排留主题/布局步）。
        HorizontalBox {
            Text {
                text: "自动提速\nAI 实时检测各线程效率并自动增加线程数以提高下载速度";
                vertical-alignment: center;
            }
            Switch {
                checked <=> root.autoSpeedUp;
                toggled => { root.autoSpeedUpChanged(self.checked); }
            }
        }
        HorizontalBox {
            Text {
                text: "最小再分配大小\n每线程剩余量大于此值时, 有线程完成或自动提速条件满足会触发重新分配";
                vertical-alignment: center;
            }
            SpinBox {
                minimum: 64;
                maximum: 102400;
                step-size: 64;
                value <=> root.maxReassignSize;
                edited(value) => { root.maxReassignSizeChanged(value); }
            }
            Text {
                text: " KB";
                vertical-alignment: center;
            }
        }
        HorizontalBox {
            Text {
                text: "保留文件修改时间\n下载完成后将文件的修改时间设为服务器提供的 Last-Modified 值";
                vertical-alignment: center;
            }
            Switch {
                checked <=> root.preserveLastModified;
                toggled => { root.preserveLastModifiedChanged(self.checked); }
            }
        }
        HorizontalBox {
            Text {
                text: "下载时验证 SSL 证书\n文件无法下载时，可尝试关闭该选项";
                vertical-alignment: center;
            }
            Switch {
                checked <=> root.verifySsl;
                toggled => { root.verifySslChanged(self.checked); }
            }
        }
        HorizontalBox {
            Text {
                text: "同名文件\n下载目录中已有同名文件时的处理方式";
                vertical-alignment: center;
            }
            ComboBox {
                model: ["保留两者", "覆盖", "询问"];
                current-index <=> root.nameConflictIndex;
                selected => { root.nameConflictChanged(self.current-index); }
            }
        }
        HorizontalBox {
            Text {
                text: "使用系统 DNS\n使用操作系统的 DNS 解析，兼容 TUN、VPN 和代理等网络环境";
                vertical-alignment: center;
            }
            Switch {
                checked <=> root.useSystemDns;
                toggled => { root.useSystemDnsChanged(self.checked); }
            }
        }
        // 第 35 步：ProxySettingCard。fluent 风格 std 无 RadioButton
        // 导出，三选单选用 ComboBox 镜像（choiceLabel 本就回显选中
        // 项文本，索引 0 Off/1 Auto/2 自定义，映射归 Rust proxy.rs）。
        // 兼容横幅（依赖功能包 proxySchemes）与 Auto 模式的系统代理
        // 检测（getproxies）留引擎桥接步。Python 端自定义字段在
        // leaveEvent 才落盘，这里每次变化回调、install 层校验有效
        // 才写（见 lib.rs 注记）。
        HorizontalBox {
            Text {
                text: "代理\n设置下载时希望使用的代理";
                vertical-alignment: center;
            }
            VerticalBox {
                ComboBox {
                    model: ["不使用代理", "自动检测系统代理", "使用自定义代理"];
                    current-index <=> root.proxyChoice;
                    selected => { root.proxyChoiceChanged(self.current-index); }
                }
                HorizontalBox {
                    ComboBox {
                        model: ["socks4", "socks5", "socks5h", "http", "https"];
                        current-index <=> root.proxyProtocolIndex;
                        enabled: root.proxyChoice == 2;
                        selected => {
                            root.proxyFieldsChanged(self.current-index, root.proxyHost,
                                root.proxyPort, root.proxyUser, root.proxyPass);
                        }
                    }
                    LineEdit {
                        placeholder-text: "代理 IP 地址";
                        text <=> root.proxyHost;
                        enabled: root.proxyChoice == 2;
                        edited(text) => {
                            root.proxyFieldsChanged(root.proxyProtocolIndex, text,
                                root.proxyPort, root.proxyUser, root.proxyPass);
                        }
                        accepted(text) => {
                            root.proxyFieldsChanged(root.proxyProtocolIndex, text,
                                root.proxyPort, root.proxyUser, root.proxyPass);
                        }
                    }
                    Text {
                        text: ":";
                        vertical-alignment: center;
                    }
                    LineEdit {
                        placeholder-text: "端口";
                        text <=> root.proxyPort;
                        enabled: root.proxyChoice == 2;
                        edited(text) => {
                            root.proxyFieldsChanged(root.proxyProtocolIndex, root.proxyHost,
                                text, root.proxyUser, root.proxyPass);
                        }
                    }
                }
                HorizontalBox {
                    Text {
                        text: "认证信息: ";
                        vertical-alignment: center;
                    }
                    LineEdit {
                        placeholder-text: "用户名（可选）";
                        text <=> root.proxyUser;
                        enabled: root.proxyChoice == 2;
                        edited(text) => {
                            root.proxyFieldsChanged(root.proxyProtocolIndex, root.proxyHost,
                                root.proxyPort, text, root.proxyPass);
                        }
                    }
                    LineEdit {
                        placeholder-text: "密码（可选）";
                        text <=> root.proxyPass;
                        input-type: password;
                        enabled: root.proxyChoice == 2;
                        edited(text) => {
                            root.proxyFieldsChanged(root.proxyProtocolIndex, root.proxyHost,
                                root.proxyPort, root.proxyUser, text);
                        }
                    }
                }
            }
        }
        // 第 36 步：Aria2 RPC 兼容组四卡（镜像 SwitchSettingCard/
        // SpinBoxSettingCard/LineEditSettingCard；令牌 LineEdit
        // input-type=password 镜像 PasswordLineEdit）。
        HorizontalBox {
            Text {
                text: "启用 Aria2 RPC 兼容";
                vertical-alignment: center;
            }
            Switch {
                checked <=> root.aria2Enabled;
                toggled => { root.aria2EnabledChanged(self.checked); }
            }
        }
        HorizontalBox {
            Text {
                text: "监听端口\nAria2 RPC 默认端口为 16800";
                vertical-alignment: center;
            }
            SpinBox {
                minimum: 1024;
                maximum: 65535;
                step-size: 1;
                value <=> root.aria2RpcPort;
                edited(value) => { root.aria2RpcPortChanged(value); }
            }
        }
        HorizontalBox {
            Text {
                text: "令牌\n若设置，客户端需传入 token 才可创建任务";
                vertical-alignment: center;
            }
            LineEdit {
                placeholder-text: "可选";
                text <=> root.aria2RpcToken;
                input-type: password;
                edited(text) => { root.aria2RpcTokenChanged(text); }
                accepted(text) => { root.aria2RpcTokenChanged(text); }
            }
        }
        HorizontalBox {
            Text {
                text: "模拟浏览器指纹\n为通过 Aria2 RPC 接收的任务附加浏览器 TLS 指纹与请求头";
                vertical-alignment: center;
            }
            Switch {
                checked <=> root.aria2EmulateFingerprint;
                toggled => { root.aria2EmulateFingerprintChanged(self.checked); }
            }
        }
        // 第 37 步：浏览器扩展组简版三卡。
        HorizontalBox {
            Text {
                text: "启用浏览器扩展";
                vertical-alignment: center;
            }
            Switch {
                checked <=> root.browserEnabled;
                toggled => { root.browserEnabledChanged(self.checked); }
            }
        }
        HorizontalBox {
            Text {
                text: "接管下载时进入草稿模式\n自动接管浏览器下载时先进入草稿，方便您调整下载路径和文件名";
                vertical-alignment: center;
            }
            Switch {
                checked <=> root.browserDraftTaken;
                toggled => { root.browserDraftTakenChanged(self.checked); }
            }
        }
        HorizontalBox {
            Text {
                text: "服务端口\n浏览器扩展连接使用的端口";
                vertical-alignment: center;
            }
            SpinBox {
                minimum: 1024;
                maximum: 65535;
                step-size: 1;
                value <=> root.browserPort;
                edited(value) => { root.browserPortChanged(value); }
            }
        }
        // 第 40 步：浏览器扩展动作卡骨架（镜像 PrimaryPushSettingCard
        // 配对令牌卡 + ToolButton 重新生成 / HyperlinkCard 商店卡
        // Firefox/Edge/Chrome 三链接 / PrimaryPushSettingCard Chromium
        // 一键安装卡 + 导出 CRX 超链接；PrimaryPush 主按钮 std 无
        // primary 变体，均以 Button 镜像，图标留主题步）。
        HorizontalBox {
            Text {
                text: "配对令牌\n" + root.pairToken;
                vertical-alignment: center;
            }
            Button {
                text: "复制令牌";
                clicked => { root.copyPairToken(); }
            }
            Button {
                text: "重新生成";
                clicked => { root.regeneratePairToken(); }
            }
        }
        HorizontalBox {
            Text {
                text: "从商店安装扩展\n商店版扩展需等待审核后才能获得更新";
                vertical-alignment: center;
            }
            Button {
                text: "Firefox 商店";
                clicked => { root.openStoreUrl("https://addons.mozilla.org/firefox/addon/ghost-downloader/"); }
            }
            Button {
                text: "Edge 商店";
                clicked => { root.openStoreUrl("https://microsoftedge.microsoft.com/addons/detail/ghost-downloader-browser/odaohmfjjbompdkmfbambadnagplcmce"); }
            }
            Button {
                text: "Chrome 商店";
                clicked => { root.openStoreUrl("https://chromewebstore.google.com/detail/ghost-downloader-for-brow/lagbjgkmaafnlinaeonbhjchnjinjpeh"); }
            }
        }
        HorizontalBox {
            Text {
                text: "安装到 Chromium 浏览器\n自动解包扩展并引导加载（Chrome / Brave 等），扩展随桌面端更新自动升级";
                vertical-alignment: center;
            }
            Button {
                text: "一键安装";
                clicked => { root.chromiumInstall(); }
            }
            Button {
                text: "导出 CRX";
                clicked => { root.exportCrx(); }
            }
        }
        // 第 41 步：模拟身份卡（IdentitySettingCard 全局默认 profile
        // 下拉的简版镜像；identityPresets 预设行列表留欠账步）。
        HorizontalBox {
            Text {
                text: "模拟身份\nTLS 指纹与 User-Agent 预设（全局默认，未被预设匹配时使用）";
                vertical-alignment: center;
            }
            ComboBox {
                model: ["自动（匹配来源）", "不模拟（原样发送）", "Chrome（最新）",
                    "Edge（最新）", "Firefox（最新）",
                    "Firefox Android（最新）", "Opera（最新）",
                    "Safari（最新）", "Safari iOS（最新）",
                    "Safari iPad（最新）", "OkHttp（最新）"];
                current-index <=> root.clientProfileIndex;
                selected => { root.clientProfileChanged(self.current-index); }
            }
        }
        // 第 42 步：请求标头预设卡（delete 按钮镜像当前预设行的
        // ToolButton——单预设时禁用，镜像 canRemove=len(presets)>1）。
        HorizontalBox {
            Text {
                text: "请求标头预设\n新建任务的标头起点";
                vertical-alignment: center;
            }
            ComboBox {
                model: root.headersPresetNames;
                current-index <=> root.headersPresetIndex;
                selected => { root.headersPresetPicked(self.current-index); }
            }
            Text {
                text: root.headersPresetHeaderCount + " 条标头";
                vertical-alignment: center;
            }
            Button {
                text: "删除预设";
                enabled: root.headersPresetCanRemove;
                clicked => { root.headersPresetRemoveRequested(root.headersPresetIndex); }
            }
        }
        // 第 43 步：身份预设行列表（PresetRowWidget 简版：名称+描述+
        // 开关+删除按钮；删除确认框/编辑对话框归调用方与欠账步）。
        VerticalBox {
            for preset[i] in root.identityPresets: HorizontalBox {
                Text {
                    text: preset.name;
                    vertical-alignment: center;
                }
                Text {
                    text: preset.desc;
                    vertical-alignment: center;
                    opacity: preset.enabled ? 1.0 : 0.4;
                }
                Switch {
                    checked: preset.enabled;
                    toggled => { root.identityPresetToggled(i, self.checked); }
                }
                Button {
                    text: "删除";
                    clicked => { root.identityPresetRemoveRequested(i); }
                }
            }
        }
        // 第 38 步：关联组 urlScheme 静态卡 + 软件组简版卡（每包关联
        // 动态卡/迁移模式动作卡/主题语言留欠账步）。
        HorizontalBox {
            Text {
                text: "允许浏览器扩展唤醒\n浏览器扩展可通过 ghostdownloader:// 协议启动桌面端";
                vertical-alignment: center;
            }
            Switch {
                checked <=> root.urlSchemeEnabled;
                toggled => { root.urlSchemeEnabledChanged(self.checked); }
            }
        }
        HorizontalBox {
            Text {
                text: "在应用程序启动时检查更新\n新版本将更稳定，并具有更多功能";
                vertical-alignment: center;
            }
            Switch {
                checked <=> root.checkUpdateAtStartup;
                toggled => { root.checkUpdateAtStartupChanged(self.checked); }
            }
        }
        HorizontalBox {
            Text {
                text: "开机启动\n在系统启动时静默运行 Ghost Downloader";
                vertical-alignment: center;
            }
            Switch {
                checked <=> root.runAtLogin;
                toggled => { root.runAtLoginChanged(self.checked); }
            }
        }
        HorizontalBox {
            Text {
                text: "关闭主窗口时\n设置关闭主窗口后程序继续在后台运行还是退出";
                vertical-alignment: center;
            }
            ComboBox {
                model: ["关闭时询问", "继续在后台运行", "退出程序"];
                current-index <=> root.closeModeIndex;
                selected => { root.closeModeChanged(self.current-index); }
            }
        }
        HorizontalBox {
            Text {
                text: "剪贴板监听\n剪贴板监听器将自动检测剪贴板中的链接并添加下载任务";
                vertical-alignment: center;
            }
            Switch {
                checked <=> root.clipboardListener;
                toggled => { root.clipboardListenerChanged(self.checked); }
            }
        }
        // 第 39 步：DpiScale 界面缩放卡（PercentSpinBoxSettingCard 镜像；
        // std SpinBox 无后缀，% 走独立 Text；显示=配置*100 步 25，
        // 换算归 install 层）。
        HorizontalBox {
            Text {
                text: "界面缩放\n改变应用程序界面的缩放比例, 0% 为自动";
                vertical-alignment: center;
            }
            SpinBox {
                minimum: 0;
                maximum: 500;
                step-size: 25;
                value <=> root.uiScalePercent;
                edited(value) => { root.uiScaleChanged(value); }
            }
            Text {
                text: " %";
                vertical-alignment: center;
            }
        }
    }
}
