// Ghost-Downloader-3 Slint 主窗口外壳组件（Phase 7c 第 57 步）。
//
// 这一层只做**形状**：导航按钮、通知条、通用消息框。文案与按钮集合由
// Rust 侧 `window.rs` 的派生函数给出（`NavItem` / `InfoBarSpec` /
// `DialogSpec`），`lib.rs` 只做 model 装配，这里不判断任何业务语义。
//
// 未镜像（Qt 侧有、Slint 侧暂缺，留给主题对齐步）：
// - `InfoBar` 的图标（`InfoBarIcon.INFORMATION`）——当前只用底色区分；
// - `MessageBoxBase` 的模态事件循环（`dialog.exec()`）——Slint 侧用
//   `visible` 覆盖层 + 回调表达，阻塞语义归调用方；
// - 标题行里的 `TransparentToolButton`（异常框的「查看日志」）；
// - 圆角/阴影/`setBorderRadius` 之类的像素级还原。

import { CheckBox } from "std-widgets.slint";

// 一个导航项。`routeKey` 是页面类名或固定按钮键（见 `window::NAV_ITEMS`）。
export struct NavItemData {
    routeKey: string,
    text: string,
    icon: string,
    selectable: bool,
    selected: bool,
}

// 通知条/消息框里的一个按钮。`index` 回传给调用方做分派（顺序即
// Python `addWidget(...)` 的顺序）。
export struct BarButtonData {
    text: string,
    index: int,
    primary: bool,
}

// 通用按钮（`PushButton` / `PrimaryPushButton`）。尺寸由内层布局的
// preferred size 决定（`HorizontalLayout` + `Text`），这样按钮宽度随文案走。
export component ShellButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    // `QPushButton.setEnabled(false)`：任务草稿的「下载」在 `canConfirm()` 为假时禁用。
    in property <bool> enabled: true;
    callback clicked;

    height: 30px;
    border-radius: 5px;
    background: !root.enabled
        ? (root.primary ? #8fb9e0 : #ededed)
        : (touch.has-hover
            ? (root.primary ? #1a5fb4 : #e4e4e4)
            : (root.primary ? #0067c0 : #f3f3f3));

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 13px;
            color: root.primary
                ? (root.enabled ? white : #f0f0f0)
                : (root.enabled ? #1a1a1a : #a0a0a0);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

// 导航按钮（`NavigationPushButton`）。选中态 = 左侧 3px 指示条 + 底色。
// `selectable == false`（「新建任务」）永远不进入选中态。
export component NavButton inherits Rectangle {
    in property <NavItemData> item;
    callback clicked;

    height: 40px;
    border-radius: 6px;
    background: (root.item.selectable && root.item.selected)
        ? #dbeafe
        : (nav-touch.has-hover && root.item.selectable ? #e9e9e9 : transparent);

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 20px;
        border-radius: 1.5px;
        background: #0067c0;
        visible: root.item.selectable && root.item.selected;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        // 图标只有名字（`FluentIcon` 的资源在主题对齐步再换）。
        Text {
            text: root.item.icon;
            font-size: 10px;
            color: root.item.selectable ? #444 : #999;
            width: 44px;
            vertical-alignment: center;
        }
        Text {
            text: root.item.text;
            font-size: 14px;
            color: root.item.selectable ? #1a1a1a : #999;
            vertical-alignment: center;
        }
    }

    nav-touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// 通知条（`InfoBar`）。按钮从右往左排，最右是关闭（`isClosable=True`）。
export component ShellInfoBar inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <[BarButtonData]> buttons;
    callback buttonClicked(int);
    callback closeRequested;

    height: 56px;
    border-radius: 6px;
    background: #eef4fb;
    border-width: 1px;
    border-color: #c7ddf5;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Text {
            text: root.title;
            font-size: 13px;
            font-weight: 700;
            color: #1a1a1a;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-size: 12px;
            color: #444;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            for b in root.buttons : ShellButton {
                text: b.text;
                primary: b.primary;
                clicked => {
                    root.buttonClicked(b.index);
                }
            }
        }
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: transparent;
            Text {
                text: "×";
                font-size: 16px;
                color: #666;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.closeRequested();
                }
            }
        }
    }
}

// 通用消息框（`MessageBoxBase` 家族：close-ask / exception / pair）。
// 遮罩铺满父元素并吞掉点击（模态）；面板居中，尺寸固定——Slint 里
// 「子布局决定父尺寸」不可用，故按有无复选框给两档高度。
export component ShellMessageDialog inherits Rectangle {
    in property <bool> opened: false;
    in property <string> title;
    in property <string> text;
    // `""` = 没有复选框（镜像 `textLayout.addWidget(checkbox)` 的有无）。
    in property <string> checkboxLabel: "";
    in-out property <bool> checkboxChecked: false;
    in property <[BarButtonData]> buttons;
    callback buttonClicked(int);
    callback checkboxToggled(bool);

    visible: root.opened;
    background: #33000000;

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 48px, 460px);
        height: root.checkboxLabel == "" ? 176px : 208px;
        border-radius: 8px;
        background: white;
        border-width: 1px;
        border-color: #e0e0e0;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: root.title;
                font-size: 15px;
                font-weight: 700;
                color: #1a1a1a;
            }
            Text {
                text: root.text;
                font-size: 13px;
                color: #333;
                wrap: word-wrap;
                vertical-stretch: 1;
            }
            if root.checkboxLabel != "" : CheckBox {
                text: root.checkboxLabel;
                checked <=> root.checkboxChecked;
                toggled => {
                    root.checkboxToggled(self.checked);
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                for b in root.buttons : ShellButton {
                    text: b.text;
                    primary: b.primary;
                    clicked => {
                        root.buttonClicked(b.index);
                    }
                }
            }
        }
    }
}
